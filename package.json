{
  "name": "deepak-brand-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static-first personal portfolio and learning project for Deepak Kumar Sahu.",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "start": "next start",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:preview": "opennextjs-cloudflare build --env preview && opennextjs-cloudflare deploy --env preview",
    "deploy:production": "opennextjs-cloudflare build --env production && opennextjs-cloudflare deploy --env production",
    "db:migrate:preview": "wrangler d1 migrations apply NEWSLETTER_DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply NEWSLETTER_DB --env production --remote",
    "smoke:preview": "bash scripts/smoke-worker.sh https://deepak-portfolio-preview.dsahu1001.workers.dev",
    "smoke:production": "bash scripts/smoke-worker.sh https://deepaksahu.dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:regression": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "harden:secrets": "git log --all -p -- . ':(exclude)node_modules' | grep -iE \"(api[_-]?key|secret|token|password|aws_)\" || true"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@supabase/supabase-js": "2.105.4",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "gray-matter": "4.0.3",
    "lucide-react": "0.468.0",
    "next": "15.5.18",
    "next-themes": "0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.0",
    "remark-html": "16.0.1",
    "resend": "3.5.0",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "0.5.13",
    "@testing-library/react": "15.0.7",
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.18",
    "eslint-config-prettier": "9.1.0",
    "postcss": "8.5.10",
    "prettier": "3.3.2",
    "prettier-plugin-tailwindcss": "0.6.5",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.2",
    "vitest": "4.1.6",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
