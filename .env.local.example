# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key-do-not-use

# Resend
RESEND_API_KEY=re_example_dummy_key

# Beehiiv
BEEHIIV_API_KEY=example-beehiiv-key
