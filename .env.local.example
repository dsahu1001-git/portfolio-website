# Site config
NEXT_PUBLIC_SITE_URL=https://deepaksahu.dev

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=deepaksahu.dev

# Affiliate redirects (comma-separated hostnames, no protocols)
ALLOWED_AFFILIATE_HOSTS=example.com
